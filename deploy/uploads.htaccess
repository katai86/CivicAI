# Másold az éles szerverre: CivicAI/uploads/.htaccess
# (ha a git pull nem viszi az uploads védelmet)
Options -Indexes

<FilesMatch "\.(?i:php|phtml|phar|php5|php7|php8|cgi|pl|asp|aspx|jsp)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "\.(?i:php|phtml)\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
